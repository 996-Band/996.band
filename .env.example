# Leave empty to keep using local /assets resources.
PUBLIC_ASSET_BASE_URL=

# Public CDN domain used to verify uploaded objects.
OSS_CDN_BASE_URL=https://oss.996.band

# OSS target. Keep the AccessKey values in .env only; never commit them.
OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_OBJECT_PREFIX=website
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=

# The content manager uploads to OSS only when this is explicitly enabled.
OSS_UPLOAD_ENABLED=false

# A second safety switch for deleting unreferenced objects with media:gc --delete.
OSS_DELETE_ENABLED=false
