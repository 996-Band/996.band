---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '996 Band',
  description = '996 Band official website — engineers, musicians, live noise.',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" href="/assets/brand/996-logo.png" />
    <title>{title}</title>
  </head>
  <body>
    <div id="top" class="page-top-anchor" aria-hidden="true"></div>
    <slot />
  </body>
</html>
