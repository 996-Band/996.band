---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  robots?: string;
}

const {
  title = '996 Band',
  description = '996 Band official website — engineers, musicians, live noise.',
  image = '/assets/design/homepage-hero-stage-clean.webp',
  type = 'website',
  robots = 'index,follow',
} = Astro.props;
const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, site).toString();
const socialImageURL = new URL(image, site).toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#050505" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/assets/brand/996-logo.png" />
    <link rel="apple-touch-icon" href="/assets/brand/996-logo.png" />
    <meta property="og:site_name" content="996 Band" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1672" />
    <meta property="og:image:height" content="941" />
    <meta property="og:image:alt" content="996 Band black-and-white LED stage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <title>{title}</title>
  </head>
  <body>
    <div id="top" class="page-top-anchor" aria-hidden="true"></div>
    <slot />
  </body>
</html>
