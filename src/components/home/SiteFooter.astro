---
import { assetUrl } from '../../lib/assets';
---

<footer id="contact" class="site-footer">
  <div class="footer-brand">
    <img src={assetUrl('/assets/brand/996-logo-transparent.png')} alt="996 Band logo" width="546" height="504" />
  </div>
  <div class="footer-col footer-media-col">
    <h3>MEDIA PLATFORM</h3>
    <div class="footer-media-list">
      <a
        class="footer-media-item"
        href="https://music.163.com/#/artist?id=54708994"
        target="_blank"
        rel="noreferrer"
      >
        <strong>
          <svg class="media-brand-icon media-brand-icon-netease" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.7 8.1a7.5 7.5 0 1 0 .6 7.1c.8-2.5-.2-5.1-2.7-6.4-2.1-1.1-4.8-.5-5.9 1.4-.9 1.5-.4 3.5 1.2 4.3 1.3.7 3 .2 3.6-1 .5-.9.2-2-.7-2.5" />
            <path d="M8.2 5.4c1.9-1 4.2-1.2 6.2-.4" />
          </svg>
          <span>NETEASE MUSIC</span>
        </strong>
      </a>
      <div class="footer-media-item footer-wechat-channel" tabindex="0">
        <strong>
          <svg class="media-brand-icon media-brand-icon-channel" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" />
            <path d="m10.2 8.7 5.3 3.3-5.3 3.3Z" />
            <path d="M4.2 6.5A10 10 0 0 1 7 3.8M19.8 17.5a10 10 0 0 1-2.8 2.7" />
          </svg>
          <span>WECHAT VIDEO CHANNEL</span>
        </strong>
        <div class="footer-qr-popover">
          <div class="footer-qr-placeholder" aria-label="微信视频号二维码待补充">
            <span>QR</span>
            <small>COMING SOON</small>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-col">
    <h3>CONTACT</h3>
    <div class="footer-contact-list">
      <div class="footer-contact-item footer-wechat-contact" tabindex="0">
        <b>
          <svg class="contact-brand-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9.3 4.4c-4 0-7.2 2.6-7.2 5.9 0 1.9 1.1 3.6 2.8 4.7l-.7 2.3 2.7-1.3c.8.2 1.6.3 2.4.3 4 0 7.2-2.7 7.2-6s-3.2-5.9-7.2-5.9Z" />
            <path d="M15.5 9.1c3.6 0 6.4 2.3 6.4 5.2 0 1.7-1 3.2-2.5 4.2l.6 2-2.4-1.1c-.7.2-1.4.3-2.1.3-3.5 0-6.4-2.4-6.4-5.3s2.9-5.3 6.4-5.3Z" />
            <circle cx="6.8" cy="9.3" r=".8" /><circle cx="11.5" cy="9.3" r=".8" />
            <circle cx="13.3" cy="14" r=".7" /><circle cx="17.4" cy="14" r=".7" />
          </svg>
          <span>微信</span>
        </b>
        <div class="footer-qr-popover">
          <div class="footer-qr-placeholder" aria-label="微信二维码待补充">
            <span>QR</span>
            <small>COMING SOON</small>
          </div>
        </div>
      </div>
      <div class="footer-contact-item footer-contact-item-disabled">
        <b>
          <svg class="contact-brand-icon contact-brand-icon-xhs" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2.2" y="4.5" width="19.6" height="15" rx="4" />
            <text x="12" y="14.7" text-anchor="middle">XHS</text>
          </svg>
          <span>小红书</span>
        </b>
      </div>
      <a class="footer-contact-item" href="https://www.yuque.com/996band" target="_blank" rel="noreferrer">
        <b>
          <svg class="contact-brand-icon contact-brand-icon-yuque" viewBox="0 0 1024 1024" aria-hidden="true">
            <path d="M854.6 370.6c-9.9-39.4 9.9-102.2 73.4-124.4l-67.9-3.6s-25.7-90-143.6-98c-117.9-8.1-195-3-195-3s87.4 55.6 52.4 154.7c-25.6 52.5-65.8 95.6-108.8 144.7-1.3 1.3-2.5 2.6-3.5 3.7C319.4 605 96 860 96 860c245.9 64.4 410.7-6.3 508.2-91.1 20.5-.2 35.9-.3 46.3-.3 135.8 0 250.6-117.6 245.9-248.4-3.2-89.9-31.9-110.2-41.8-149.6z" />
          </svg>
          <span>语雀</span>
        </b>
      </a>
      <a class="footer-contact-item" href="https://github.com/996-Band/" target="_blank" rel="noreferrer">
        <b>
          <svg class="contact-brand-icon contact-brand-icon-github" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M15 22v-3.9c.04-1-.35-1.8-1-2.4 3.3-.37 6.7-1.62 6.7-7.4A5.8 5.8 0 0 0 19.2 4c.15-.38.65-1.9-.15-4 0 0-1.25-.4-4.1 1.53a14.1 14.1 0 0 0-7.45 0C4.65-.4 3.4 0 3.4 0c-.8 2.1-.3 3.62-.15 4A5.8 5.8 0 0 0 1.7 8.3c0 5.77 3.45 7.02 6.73 7.4-.43.38-.8 1.02-.94 1.97-.85.38-3 .99-4.33-1.24 0 0-.79-1.43-2.29-1.54 0 0-1.46-.02-.1.91 0 0 .98.46 1.66 2.18 0 0 .88 2.9 5 1.92V22" />
          </svg>
          <span>GitHub</span>
        </b>
      </a>
    </div>
  </div>
</footer>
<p class="site-powered-by">© 2015-NOW 996 BAND. ALL RIGHTS RESERVED. THE ENTIRE WEB CONTENT IS POWERED BY CODEX.</p>
